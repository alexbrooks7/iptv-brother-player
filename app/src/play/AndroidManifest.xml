<?xml version="1.0" encoding="utf-8"?>
<!--
  Google Play flavor.

  Play's TV listing requires the app to declare the Leanback feature. Marking it
  required="true" restricts distribution to TV devices, which is what we want on
  Play: the UI is 10-foot/D-pad only and would rate badly if phone users
  installed it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="true" />
</manifest>
