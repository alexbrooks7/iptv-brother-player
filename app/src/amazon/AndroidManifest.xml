<?xml version="1.0" encoding="utf-8"?>
<!--
  Amazon Appstore / Fire TV flavor.

  Leanback is declared but NOT required. Fire OS supports the leanback feature
  on current Fire TV hardware, but Amazon's device targeting is done in the
  developer console by device model rather than by manifest features, and a
  hard requirement here has historically caused Fire TV devices to be excluded
  from the supported-device list at submission time.

  Note there is deliberately no GMS dependency anywhere in the project, so this
  flavor needs no substitutions — see README "Fire TV / no-GMS".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
</manifest>
