<?xml version="1.0" encoding="utf-8"?>
<!--
     Merged into the main manifest only for the sideload flavour. The store
     flavour (Play Store, Amazon Appstore) has no equivalent file, so it never
     declares this permission or service — both stores prohibit apps that
     route other users' traffic through a device, and simply not having the
     library on the classpath (see build.gradle.kts "distribution") is not
     enough on its own if the manifest still advertised the service.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required by the Pawns peer service below on API 34+. The service
         only ever runs after the viewer explicitly accepts the consent
         dialog, and only in builds configured with a pawns.apiKey. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <!-- Pawns bandwidth-sharing peer service.
             Foreground rather than background, deliberately: while this runs the
             device is acting as a gateway for someone else's internet traffic,
             and a foreground service is what guarantees a persistent, visible
             notification for as long as that is true. Nobody should have to
             wonder whether sharing is still on. Started only from
             PawnsManager.startSharing(), which is reached from the consent
             dialog or the Settings toggle. -->
        <service
            android:name="com.pawns.sdk.internal.service.PeerServiceForeground"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Allows to share internet traffic by modifying device's network settings to be used as a gateway for internet traffic. Device becomes a gateway which allows to send and receive internet traffic." />
        </service>
        <meta-data
            android:name="com.pawns.sdk.pawns_service_channel_name"
            android:value="Internet Sharing" />
    </application>
</manifest>
